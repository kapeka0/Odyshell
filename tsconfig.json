{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@odyshell/client": ["apps/client/src/index.ts"],
      "@odyshell/mcp": ["packages/mcp/src/index.ts"],
      "@odyshell/protocol": ["packages/protocol/src/index.ts"],
      "@odyshell/sdk": ["packages/sdk/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "tests/**/*.ts"],
  "exclude": ["apps/web"]
}
