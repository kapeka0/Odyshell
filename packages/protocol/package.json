{
  "name": "@odyshell/protocol",
  "version": "0.15.1",
  "description": "Shared TypeScript contracts for Odyshell Server, Client, and SDK.",
  "keywords": [
    "ai-agents",
    "protocol",
    "remote-execution"
  ],
  "homepage": "https://odyshell.com/docs/concepts",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/kapeka0/Odyshell/issues"
  },
  "repository": {
