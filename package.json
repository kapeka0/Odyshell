{
  "name": "odyshell",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "start": "node apps/server/dist/index.js",
    "typecheck": "tsc --noEmit && pnpm --filter @odyshell/web typecheck",
    "test": "vitest run",
    "test:docs": "node scripts/docs-smoke.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:self-host": "node scripts/self-host-smoke.mjs",
    "migrate:identity": "tsx apps/web/src/migrate-identity.ts",
    "release:check": "node scripts/release-check.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "install:ods": "pnpm --filter @odyshell/client build && pnpm --filter @odyshell/cli build && npm install --global ./apps/cli",
    "dev:server": "pnpm --filter @odyshell/server dev",
    "dev:web": "pnpm --filter @odyshell/web dev",
    "ods": "tsx apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.13.3",
    "fastify": "^5.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
