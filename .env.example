PORT=4100
HOST=0.0.0.0
DATABASE_URL=postgres://odyshell:odyshell@127.0.0.1:55432/odyshell
ODYSHELL_ADMIN_KEY=dev-admin-key
ODYSHELL_AGENT_KEY=dev-agent-key
# Optional cloud bridge. Leave unset for a standalone self-hosted Server.
ODYSHELL_WEB_KEY=
ODYSHELL_WEB_URL=http://localhost:3000
# Odyshell Identity and optional remote MCP.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# ODYSHELL_MCP_URL=https://mcp.example.com/mcp
# ODYSHELL_MCP_ALLOWED_ORIGINS=https://app.example.com
# ODYSHELL_IDENTITY_ISSUER=https://app.example.com
# ODYSHELL_IDENTITY_JWKS_URL=https://app.example.com/api/auth/jwks
# Optional. Required to store Event Sink signing secrets.
ODYSHELL_EVENT_SINK_ENCRYPTION_KEY=REPLACE_WITH_A_BASE64URL_32_BYTE_KEY
