# Copy this file to .env. Never commit the populated file.
POSTGRES_PASSWORD=
ODYSHELL_WEB_KEY=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
NEXT_PUBLIC_ODYSHELL_SERVER_URL=http://localhost:4100
ODYSHELL_MCP_URL=http://localhost:4100/mcp
ODYSHELL_COMMAND_OUTPUT_RETENTION_DAYS=30
ODYSHELL_AUDIT_RETENTION_DAYS=30


# Loopback-only defaults. Set the public HTTPS origins and bind address for a remote deployment.
ODYSHELL_BIND_ADDRESS=127.0.0.1
ODYSHELL_WEB_PORT=3000
ODYSHELL_SERVER_PORT=4100
ODYSHELL_POSTGRES_PORT=55432

# Optional Google sign-in. Configure both secrets and enable the build-time UI flag together.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Optional generic OIDC sign-in (Keycloak, Authentik, ZITADEL, Okta, or another OIDC IdP).
# Configure all three server values and enable the matching build-time UI flag together.
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
OIDC_PROVIDER_ID=oidc
NEXT_PUBLIC_OIDC_AUTH_ENABLED=false
NEXT_PUBLIC_OIDC_PROVIDER_ID=oidc
