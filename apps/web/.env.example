# Local pnpm development only. Docker Compose reads the root .env instead.
DATABASE_URL=postgresql://odyshell:replace-with-the-root-postgres-password@127.0.0.1:55432/odyshell
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
ODYSHELL_DEPLOYMENT_MODE=self-hosted
ODYSHELL_MCP_URL=http://localhost:4100/mcp
ODYSHELL_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Optional Google sign-in. Configure both server values and expose only the flag.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

NEXT_PUBLIC_ODYSHELL_SERVER_URL=http://localhost:4100
ODYSHELL_SERVER_URL=http://localhost:4100
ODYSHELL_WEB_KEY=
