{
  "name": "@odyshell/cli",
  "version": "0.19.0",
  "description": "Install and operate an Odyshell Client on Linux, macOS, or Windows.",
  "keywords": [
    "ai-agents",
    "cli",
    "agent-infrastructure",
    "remote-execution"
  ],
  "homepage": "https://odyshell.com/docs/cli",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/kapeka0/Odyshell/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kapeka0/Odyshell.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "bin": {
    "ods": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "cpu": [
    "arm64",
    "x64"
  ],
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsup",
    "prepack": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@odyshell/client": "workspace:*",
    "@odyshell/protocol": "workspace:*"
  }
}
