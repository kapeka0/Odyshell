[Unit]
Description=Odyshell outbound connector
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=odyshell
Group=odyshell
ExecStart=/usr/local/bin/odyshell-connector start --config /etc/odyshell/connector.json
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/odyshell

[Install]
WantedBy=multi-user.target
